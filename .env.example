PORT=3000
NODE_ENV=development
TRUST_PROXY=false
STORE_NAME=The Barrel House
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
SUPPORT_EMAIL=
CURRENCY=INR
AGE_VERIFICATION_REQUIRED=true
ALLOW_DEVELOPMENT_PRODUCTS=true
DATABASE_PATH=./data/barrel-house.sqlite
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-before-use

# Razorpay sandbox/test credentials. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Keep empty until the owner confirms serviceable postal codes.
DELIVERY_POSTAL_CODES=
DELIVERY_FEE=0
MINIMUM_ORDER_VALUE=0

# Production must terminate HTTPS before exposing the admin or payment routes.
