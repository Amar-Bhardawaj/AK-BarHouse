PORT=3000
NODE_ENV=development
TRUST_PROXY=false
STORE_NAME=The Barrel House
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
SUPPORT_EMAIL=
CURRENCY=INR
AGE_VERIFICATION_REQUIRED=true
ALLOW_DEVELOPMENT_PRODUCTS=true
DATABASE_PATH=./data/barrel-house.sqlite
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-before-use

# Razorpay sandbox/test credentials. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set only during an explicit approved production import; keep the approved export outside public/.
CONFIRM_PRODUCT_IMPORT=
PRODUCTS_FILE=

# Keep empty until the owner confirms serviceable postal codes.
DELIVERY_POSTAL_CODES=
DELIVERY_FEE=0
MINIMUM_ORDER_VALUE=0

# Production must terminate HTTPS before exposing the admin or payment routes.
